// Quản lý LocalStorage cho Editor Mode
const StorageManager = {
  getConfig() {
    const saved = localStorage.getItem('site_config_2010');
    if (saved) {
      try { return JSON.parse(saved); } catch (e) { console.error(e); }
    }
    return DEFAULT_CONFIG;
  },
  saveConfig(config) {
    localStorage.setItem('site_config_2010', JSON.stringify(config));
  },
  resetConfig() {
    localStorage.removeItem('site_config_2010');
    return DEFAULT_CONFIG;
  }
};
